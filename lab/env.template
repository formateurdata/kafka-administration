# Lab Kafka Administration (PLB IKAF) - variables Docker Compose
#
# Ce fichier est un MODELE. docker-compose.yml contient deja ces valeurs
# par defaut : le lab fonctionne sans fichier .env.
# Pour personnaliser (ports, memoire, versions) :
#     cp env.template .env      puis modifier .env
# Docker Compose lit automatiquement .env dans le dossier lab/.
#
# Valeurs de LABORATOIRE : ne jamais reprendre ces mots de passe en production.

# ---------------------------------------------------------------
# Versions des images (verifiees le 27/10/2026)
# ---------------------------------------------------------------
KAFKA_IMAGE=m0uaad/kafka-lab-kafka:4.3.2-1
JUPYTER_IMAGE=m0uaad/kafka-lab-jupyter:1
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.2.4
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.9.0
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.3.2
JMX_EXPORTER_VERSION=1.7.0
# Images preconstruites : voir images/README.md. Versions dans jupyter/Dockerfile
# et jupyter/requirements.txt (python 3.13.15, jupyterlab 4.6.4, confluent-kafka 2.16.0).

# ---------------------------------------------------------------
# Identite du cluster KRaft
# Generes une fois avec : kafka-storage.sh random-uuid
# Tous les noeuds d'un cluster partagent le meme CLUSTER_ID.
# Chaque controleur a un identifiant de repertoire (directory.id)
# utilise par --initial-controllers (quorum dynamique, KIP-853).
# Changer ces valeurs impose un reset complet (scripts/reset.sh).
# ---------------------------------------------------------------
CLUSTER_ID=W5FmqobtRp-BMcXlZhVKBw
KAFKA_1_DIR_ID=4EubdzSZTbykbeqlrbgz1Q
KAFKA_2_DIR_ID=D-l1kOfvTxmWUQ9mDz8CFQ
KAFKA_3_DIR_ID=rUNdHnJlQu6wfWRz_G30kA

# ---------------------------------------------------------------
# Memoire des noeuds Kafka (lab : 512 Mo de heap ; production : 6 a 8 Go)
# ---------------------------------------------------------------
KAFKA_NODE_HEAP_OPTS=-Xms512m -Xmx512m
KAFKA_NODE_MEM_LIMIT=1g

# ---------------------------------------------------------------
# Ports publies sur la machine hote (changer en cas de conflit)
# Les ports EXTERNAL de Kafka (9092, 9192, 9292, 9392) sont fixes :
# ils figurent aussi dans advertised.listeners de chaque server.properties.
# ---------------------------------------------------------------
KAFKA_UI_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
SCHEMA_REGISTRY_PORT=8081
CONNECT_PORT=8083
# JupyterLab : publie sur 127.0.0.1 seulement (voir docker-compose.yml)
JUPYTER_PORT=8888
# Jeton facultatif de JupyterLab, vide par defaut. VS Code en a besoin : jupyter/README.md
JUPYTER_TOKEN=

# ---------------------------------------------------------------
# Secrets de laboratoire
# ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=kafka-lab
# Compte SCRAM de MirrorMaker 2 sur le cluster cloud (TP9). A changer aussi
# dans config/mirrormaker/mm2.properties.
MM2_PASSWORD=mm2-secret

# ---------------------------------------------------------------
# Cluster cloud, cible de MirrorMaker 2 (profil mirror, TP9)
# Changer cette valeur impose de supprimer le volume kafka-cloud-data.
# ---------------------------------------------------------------
CLOUD_CLUSTER_ID=tF2HiBQuSD6MqpTGGGBVfA

# ---------------------------------------------------------------
# Generateur de charge (profil load)
# ---------------------------------------------------------------
LOADGEN_TOPIC=loadgen
LOADGEN_THROUGHPUT=100
LOADGEN_RECORD_SIZE=256
